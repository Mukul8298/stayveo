# Used only by the server-side Tiffin KYC signed-upload route.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KYC_BUCKET=provider-kyc-documents
SUPABASE_SERVICE_ROLE_KEY=<server-only-secret>

# Tiffin payment adapter. `mock` is development-only and never charges money.
# Replace with `razorpay` only after a server-side Razorpay provider is added.
PAYMENT_MODE=mock

# Frontend URL used for deployment/documentation. The backend also allows
# localhost, Cloudflare tunnels, and *.devtunnels.ms in development.
FRONTEND_URL=http://localhost:5173

# Server-side sessions
REDIS_URL=redis://localhost:6379
SESSION_SECRET=replace-with-a-long-random-server-secret
# Optional dedicated key for encrypting provider bank account numbers. If it
# is omitted, SESSION_SECRET is used as the encryption key.
BANK_DETAILS_ENCRYPTION_KEY=replace-with-a-long-random-bank-details-key
# Set to `none` when the deployed frontend and API are on different sites.
# SameSite=None requires HTTPS, so production cookies are Secure.
SESSION_SAME_SITE=lax
# Optional provider-session override. If omitted, SESSION_SAME_SITE is used.
# PROVIDER_SESSION_SAME_SITE=none
