// ─── TIFFIN KITCHEN (Owner Onboarding) ──────────────────────────────────

model TiffinKitchen {
  id                       String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId                  String                    @unique @map("owner_id") @db.Uuid
  kitchenName              String                    @map("kitchen_name") @db.VarChar(200)
  kitchenLogo              String?                   @map("kitchen_logo")
  coverImage               String?                   @map("cover_image")
  description              String?
  foodOptions              Json?                     @map("food_options")
  ownerName                String                    @map("owner_name") @db.VarChar(150)
  phone                    String                    @db.VarChar(15)
  email                    String?                   @db.VarChar(255)
  gstNumber                String?                   @map("gst_number") @db.VarChar(20)
  fssaiLicenseNumber       String?                   @map("fssai_license_number") @db.VarChar(30)

  // Location
  address                  String?
  latitude                 Decimal?                  @db.Decimal(9, 6)
  longitude                Decimal?                  @db.Decimal(9, 6)
  pincode                  String?                   @db.VarChar(10)
  city                     String?                   @db.VarChar(100)
  state                    String?                   @db.VarChar(100)
  deliveryRadiusKm         Decimal                   @default(5.0) @map("delivery_radius_km") @db.Decimal(5, 2)

  // Service Attributes
  foodType                 TiffinFoodType            @default(VEG) @map("food_type")
  breakfastAvailable       Boolean                   @default(false) @map("breakfast_available")
  lunchAvailable           Boolean                   @default(true) @map("lunch_available")
  dinnerAvailable          Boolean                   @default(true) @map("dinner_available")
  mealsPerDay              Int                       @default(2) @map("meals_per_day")

  // Pricing & Charges
  securityDeposit          Decimal                   @default(0.00) @map("security_deposit") @db.Decimal(10, 2)
  deliveryCharges          Decimal                   @default(0.00) @map("delivery_charges") @db.Decimal(10, 2)
  packingCharges           Decimal                   @default(0.00) @map("packing_charges") @db.Decimal(10, 2)
  extraMealPrice           Decimal                   @default(80.00) @map("extra_meal_price") @db.Decimal(10, 2)

  // Weekly Off
  isSundayClosed           Boolean                   @default(false) @map("is_sunday_closed")
  customWeeklyOff          String?                   @map("custom_weekly_off") @db.VarChar(20)

  // Dietary Customization Flags
  allowsJain               Boolean                   @default(false) @map("allows_jain")
  allowsLowOil             Boolean                   @default(false) @map("allows_low_oil")
  allowsDiabeticDiet       Boolean                   @default(false) @map("allows_diabetic_diet")
  allowsHighProtein        Boolean                   @default(false) @map("allows_high_protein")
  allowsCustomInstructions Boolean                   @default(true) @map("allows_custom_instructions")

  // Delivery Mode
  deliveryType             TiffinDeliveryType        @default(SELF_DELIVERY) @map("delivery_type")
  pickupAvailable          Boolean                   @default(false) @map("pickup_available")

  // Policies
  cancellationPolicy       String?                   @map("cancellation_policy")
  refundPolicy             String?                   @map("refund_policy")

  // Statuses
  status                   KitchenStatus             @default(OPEN)
  verificationStatus       KitchenVerificationStatus @default(PENDING) @map("verification_status")

  // Cached metrics (updated on write operations)
  averageRating            Decimal                   @default(0.00) @map("average_rating") @db.Decimal(3, 2)
  totalReviews             Int                       @default(0) @map("total_reviews")

  createdAt                DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                DateTime?                 @map("deleted_at") @db.Timestamptz(6)

  // Relations
  images            TiffinKitchenImage[]
  mealTimings       TiffinKitchenMealTiming[]
  weeklyMenus       TiffinKitchenWeeklyMenu[]
  subscriptionPlans TiffinSubscriptionPlan[]
  subscriptions     TiffinCustomerSubscription[]
  mealLogs          TiffinMealLog[]
  reviews           TiffinReview[]
  complaints        TiffinComplaint[]
  activityLogs      TiffinActivityLog[]

  @@index([latitude, longitude])
  @@index([city, status, verificationStatus])
  @@map("tiffin_kitchens")
}

model TiffinKitchenImage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kitchenId String   @map("kitchen_id") @db.Uuid
  imageUrl  String   @map("image_url")
  caption   String?
  sortOrder Int      @default(0) @map("sort_order")
