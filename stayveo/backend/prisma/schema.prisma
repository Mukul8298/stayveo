// ─── CUSTOMER SUBSCRIPTIONS ─────────────────────────────────────────────

model TiffinCustomerSubscription {
  id                  String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscriptionCode    String                   @unique @map("subscription_code") @db.VarChar(30)
  kitchenId           String                   @map("kitchen_id") @db.Uuid
  customerId          String                   @map("customer_id") @db.Uuid
  planId              String                   @map("plan_id") @db.Uuid

  // Preferences
  dietPreference      TiffinFoodType           @default(VEG) @map("diet_preference")
  customInstructions  String?                  @map("custom_instructions")
  optedBreakfast      Boolean                  @default(true) @map("opted_breakfast")
  optedLunch          Boolean                  @default(true) @map("opted_lunch")
  optedDinner         Boolean                  @default(true) @map("opted_dinner")

  // Delivery
  deliveryAddress     String?                  @map("delivery_address")
  deliveryLatitude    Decimal?                 @map("delivery_latitude") @db.Decimal(9, 6)
  deliveryLongitude   Decimal?                 @map("delivery_longitude") @db.Decimal(9, 6)

  // Reservation snapshot. A PENDING row is the reservation; it becomes the
  // active subscription only after the payment adapter confirms it.
  amount              Decimal                  @default(0.00) @db.Decimal(10, 2)
  currency            String                   @default("INR") @db.VarChar(3)

  // Lifecycle
  startDate           DateTime                 @map("start_date") @db.Date
  endDate             DateTime                 @map("end_date") @db.Date
  totalMealsAllocated Int                      @map("total_meals_allocated")
  mealsRemaining      Int                      @map("meals_remaining")
  mealsConsumed       Int                      @default(0) @map("meals_consumed")
  mealsSkipped        Int                      @default(0) @map("meals_skipped")
  totalEntitledDays   Int                      @default(28) @map("total_entitled_days")
  consumedDays        Int                      @default(0) @map("consumed_days")
  remainingDays       Int                      @default(28) @map("remaining_days")
  paymentStatus       TiffinPaymentStatus      @default(PENDING) @map("payment_status")

  // Status
  status              TiffinSubscriptionStatus @default(PENDING)
  autoRenew           Boolean                  @default(false) @map("auto_renew")
  pausedAt            DateTime?                @map("paused_at") @db.Timestamptz(6)
  resumedAt           DateTime?                @map("resumed_at") @db.Timestamptz(6)
  cancelledAt         DateTime?                @map("cancelled_at") @db.Timestamptz(6)
  confirmedAt         DateTime?                @map("confirmed_at") @db.Timestamptz(6)

  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?                @map("deleted_at") @db.Timestamptz(6)

  // Relations
  kitchen     TiffinKitchen                    @relation(fields: [kitchenId], references: [id], onDelete: Restrict)
  plan        TiffinSubscriptionPlan           @relation(fields: [planId], references: [id], onDelete: Restrict)
  pauseLogs   TiffinSubscriptionPauseLog[]
  renewalLogs TiffinSubscriptionRenewalLog[]
  payments    TiffinPayment[]
  subscriptionDays TiffinSubscriptionDay[]
  mealLogs    TiffinMealLog[]
  reviews     TiffinReview[]
  complaints  TiffinComplaint[]

  @@index([customerId, status])
  @@index([kitchenId, status, endDate])
  @@map("tiffin_customer_subscriptions")
}

model TiffinSubscriptionDay {
  id             String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscriptionId String                      @map("subscription_id") @db.Uuid
  serviceDate    DateTime                    @map("service_date") @db.Date
  status         TiffinSubscriptionDayStatus @default(PENDING)
  consumed       Boolean                     @default(false)
  consumedAt     DateTime?                   @map("consumed_at") @db.Timestamptz(6)
  createdAt      DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscription TiffinCustomerSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  mealLogs     TiffinMealLog[]

  @@unique([subscriptionId, serviceDate])
  @@index([serviceDate, status, consumed])
  @@map("tiffin_subscription_days")
}

model TiffinSubscriptionPauseLog {
