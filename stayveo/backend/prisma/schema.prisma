  paymentId      String?  @map("payment_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  subscription TiffinCustomerSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("tiffin_subscription_renewal_logs")
}

// ─── MEAL TRACKING ──────────────────────────────────────────────────────

model TiffinMealLog {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscriptionId String        @map("subscription_id") @db.Uuid
  kitchenId      String        @map("kitchen_id") @db.Uuid
  customerId     String        @map("customer_id") @db.Uuid
  mealDate       DateTime      @map("meal_date") @db.Date
  mealCategory   MealCategory  @map("meal_category")
  subscriptionDayId String?     @map("subscription_day_id") @db.Uuid
  status         MealLogStatus @default(SCHEDULED)
  isExtraMeal    Boolean       @default(false) @map("is_extra_meal")
  extraMealPrice Decimal       @default(0.00) @map("extra_meal_price") @db.Decimal(10, 2)
  deliveryOtp    String?       @map("delivery_otp") @db.VarChar(6)
  deliveredAt    DateTime?     @map("delivered_at") @db.Timestamptz(6)
  deliveredByProviderId String? @map("delivered_by_provider_id") @db.Uuid
  skippedAt      DateTime?     @map("skipped_at") @db.Timestamptz(6)
  missedAt       DateTime?     @map("missed_at") @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscription   TiffinCustomerSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  kitchen        TiffinKitchen              @relation(fields: [kitchenId], references: [id], onDelete: Cascade)
  subscriptionDay TiffinSubscriptionDay?    @relation(fields: [subscriptionDayId], references: [id], onDelete: SetNull)
