  kitchen       TiffinKitchen                @relation(fields: [kitchenId], references: [id], onDelete: Cascade)
  subscriptions TiffinCustomerSubscription[]

  @@index([kitchenId, isActive])
  @@map("tiffin_subscription_plans")
