// ─── SUBSCRIPTION PLANS ─────────────────────────────────────────────────

model TiffinSubscriptionPlan {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kitchenId     String         @map("kitchen_id") @db.Uuid
  planName      String         @map("plan_name") @db.VarChar(150)
  planType      TiffinPlanType @map("plan_type")
  durationDays  Int            @map("duration_days")
  totalMeals    Int            @map("total_meals")
  price         Decimal        @db.Decimal(10, 2)
  discountPrice Decimal?       @map("discount_price") @db.Decimal(10, 2)
  description   String?
