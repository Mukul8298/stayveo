  deliveryPersonName  String?  @map("delivery_person_name") @db.VarChar(150)
  deliveryPersonPhone String?  @map("delivery_person_phone") @db.VarChar(15)
  verifiedOtp         String?  @map("verified_otp") @db.VarChar(6)
  deliveryNotes       String?  @map("delivery_notes")
  proofImageUrl       String?  @map("proof_image_url")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  mealLog TiffinMealLog @relation(fields: [mealLogId], references: [id], onDelete: Cascade)

  @@map("tiffin_meal_deliveries")
}

// ─── PAYMENTS & INVOICES ────────────────────────────────────────────────

model TiffinPayment {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscriptionId String              @map("subscription_id") @db.Uuid
  kitchenId      String              @map("kitchen_id") @db.Uuid
  customerId     String              @map("customer_id") @db.Uuid
  transactionId  String?             @unique @map("transaction_id") @db.VarChar(128)
  idempotencyKey String?             @unique @map("idempotency_key") @db.VarChar(128)
  paymentGateway String?             @map("payment_gateway") @db.VarChar(50)
  providerOrderId String?            @map("provider_order_id") @db.VarChar(128)
  providerPaymentId String?          @map("provider_payment_id") @db.VarChar(128)
  currency       String              @default("INR") @db.VarChar(3)
  paymentMethod  TiffinPaymentMethod @default(UPI) @map("payment_method")
  status         TiffinPaymentStatus @default(PENDING)

  // Breakdown
  baseAmount     Decimal             @map("base_amount") @db.Decimal(10, 2)
  discountAmount Decimal             @default(0.00) @map("discount_amount") @db.Decimal(10, 2)
  couponCode     String?             @map("coupon_code") @db.VarChar(30)
  gstAmount      Decimal             @default(0.00) @map("gst_amount") @db.Decimal(10, 2)
  platformFee    Decimal             @default(0.00) @map("platform_fee") @db.Decimal(10, 2)
  packingCharge  Decimal             @default(0.00) @map("packing_charge") @db.Decimal(10, 2)
  deliveryCharge Decimal             @default(0.00) @map("delivery_charge") @db.Decimal(10, 2)
  totalAmount    Decimal             @map("total_amount") @db.Decimal(10, 2)
  refundAmount   Decimal             @default(0.00) @map("refund_amount") @db.Decimal(10, 2)

  paidAt    DateTime? @map("paid_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscription TiffinCustomerSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  invoice      TiffinInvoice?
  refunds      TiffinRefund[]

  @@index([subscriptionId, status])
  @@index([kitchenId, status, paidAt])
  @@index([customerId, status])
  @@map("tiffin_payments")
}

model TiffinInvoice {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId     String   @unique @map("payment_id") @db.Uuid
  invoiceNumber String   @unique @map("invoice_number") @db.VarChar(60)
  pdfUrl        String?  @map("pdf_url")
  issuedAt      DateTime @default(now()) @map("issued_at") @db.Timestamptz(6)

  payment TiffinPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("tiffin_invoices")
}

model TiffinRefund {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId   String   @map("payment_id") @db.Uuid
  refundRefId String   @unique @map("refund_ref_id") @db.VarChar(100)
  amount      Decimal  @db.Decimal(10, 2)
  reason      String?
  status      String   @default("PROCESSED") @db.VarChar(30)
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  payment TiffinPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("tiffin_refunds")
}

// ─── REVIEWS & COMPLAINTS ───────────────────────────────────────────────

model TiffinReview {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kitchenId      String   @map("kitchen_id") @db.Uuid
  customerId     String   @map("customer_id") @db.Uuid
  subscriptionId String?  @map("subscription_id") @db.Uuid
  rating         Int      // 1-5
  comment        String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  kitchen      TiffinKitchen               @relation(fields: [kitchenId], references: [id], onDelete: Cascade)
  subscription TiffinCustomerSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([kitchenId, rating])
  @@map("tiffin_reviews")
}

model TiffinComplaint {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketNumber   String               @unique @map("ticket_number") @db.VarChar(30)
  kitchenId      String               @map("kitchen_id") @db.Uuid
  customerId     String               @map("customer_id") @db.Uuid
  subscriptionId String?              @map("subscription_id") @db.Uuid
  mealLogId      String?              @map("meal_log_id") @db.Uuid
  category       String               @default("Other") @db.VarChar(80)
  subject        String               @db.VarChar(200)
  description    String
  status         TiffinComplaintStatus @default(OPEN)
  resolutionNote String?              @map("resolution_note")
  providerResponse String?            @map("provider_response")
  resolvedAt     DateTime?            @map("resolved_at") @db.Timestamptz(6)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  kitchen      TiffinKitchen               @relation(fields: [kitchenId], references: [id], onDelete: Cascade)
  subscription TiffinCustomerSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  mealLog      TiffinMealLog?              @relation(fields: [mealLogId], references: [id], onDelete: SetNull)

  @@index([kitchenId, status])
  @@map("tiffin_complaints")
}

// ─── ACTIVITY LOG & NOTIFICATIONS ───────────────────────────────────────

model TiffinActivityLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kitchenId   String   @map("kitchen_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  action      String   @db.VarChar(100)
  description String
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  kitchen TiffinKitchen @relation(fields: [kitchenId], references: [id], onDelete: Cascade)

  @@index([kitchenId, createdAt])
  @@map("tiffin_activity_logs")
}

model TiffinNotification {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  kitchenId String?  @map("kitchen_id") @db.Uuid
  title     String   @db.VarChar(200)
  message   String
  type      String   @db.VarChar(50)
  isRead    Boolean  @default(false) @map("is_read")
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, isRead, createdAt])
  @@map("tiffin_notifications")
}
