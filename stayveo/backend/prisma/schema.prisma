// ─── StayVeo Prisma Schema ──────────────────────────────────────────────
// Mapped to the EXISTING PostgreSQL database on Supabase.
// All models match the real DB tables. Enums use PascalCase names with
// @map() to preserve the actual lowercase Postgres enum values.
// ────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── ENUMS ──────────────────────────────────────────────────────────────
// PascalCase in code → lowercase in Postgres via @map on enum name

enum UserRole {
  STUDENT  @map("student")
  PROVIDER @map("provider")

  @@map("user_role")
}

enum GenderType {
  MALE              @map("male")
  FEMALE            @map("female")
  OTHER             @map("other")
  PREFER_NOT_TO_SAY @map("prefer_not_to_say")

  @@map("gender_type")
}

enum FoodPreference {
  VEG           @map("veg")
  NONVEG        @map("nonveg")
  JAIN          @map("jain")
  VEGAN         @map("vegan")
  NO_PREFERENCE @map("no_preference")

  @@map("food_pref")
}

enum LifestyleType {
  EARLY_BIRD @map("early_bird")
  NIGHT_OWL  @map("night_owl")
  FLEXIBLE   @map("flexible")

  @@map("lifestyle_type")
}

enum StudyHabit {
  QUIET    @map("quiet")
  FLEXIBLE @map("flexible")
  NORMAL   @map("normal")

  @@map("study_habit")
}

enum SocialLevel {
  INTROVERT @map("introvert")
  EXTROVERT @map("extrovert")
  AMBIVERT  @map("ambivert")

  @@map("social_level")
}

enum ServiceCategory {
  PG     @map("pg")
  TIFFIN @map("tiffin")

  @@map("service_category")
}

enum ServiceType {
  PG
  TIFFIN

  @@map("provider_service_type")
}

enum FoodType {
  VEG    @map("veg")
  NONVEG @map("nonveg")
  JAIN   @map("jain")
  VEGAN  @map("vegan")

  @@map("food_type")
}

enum DocType {
  ID_PROOF       @map("id_proof")
  BUSINESS_PROOF @map("business_proof")

  @@map("doc_type")
}

// ─── USERS ──────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Kept for existing phone-auth data and provider/business workflows. New
  // email-auth accounts may not have a phone until provider onboarding.
  phone_number String?  @unique @db.VarChar(15)
  email        String?  @unique @db.VarChar(255)
  passwordHash String?  @map("password_hash") @db.VarChar(255)
  role         UserRole
  collegeId    String?  @map("college_id") @db.Uuid
  collegeName  String?  @map("college_name")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  studentProfile          StudentProfile?
  provider                Provider?
  providerProfile         ProviderProfile?
  college                 College?                 @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  savedListings           SavedListing[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  emailAuthChallenges      EmailAuthChallenge[]

  @@map("users")
}

// Pending email login/signup verification. OTPs are stored as SHA-256 hashes
// and removed after successful verification; this table is never returned to
// the frontend.
model EmailAuthChallenge {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @db.VarChar(255)
  role         UserRole
  purpose      String   @db.VarChar(32)
  otpHash      String   @map("otp_hash") @db.VarChar(64)
  passwordHash String?  @map("password_hash") @db.VarChar(255)
  userId       String?  @map("user_id") @db.Uuid
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, role, purpose])
  @@index([expiresAt])
  @@map("email_auth_challenges")
}

// ─── STUDENT PROFILES ───────────────────────────────────────────────────

model StudentProfile {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String          @unique @map("user_id") @db.Uuid
  fullName           String          @map("name")
  college            String
  year               Int?
  gender             GenderType?
  foodPreference     FoodPreference? @map("food_preference")
  sleepSchedule      LifestyleType?  @map("lifestyle")
  cleanlinessLevel   Int?            @map("cleanliness_level")
  studyHabits        StudyHabit?     @map("study_habits")
  personalityType    SocialLevel?    @map("personality_type")
  locationPreference String?         @map("location_preference")
  currentAddress     String?         @map("current_address")
  latitude           Float?
  longitude          Float?
  budget             String?
  profileImageUrl    String?         @map("profile_image_url")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

// ─── PROVIDERS ──────────────────────────────────────────────────────────

model Provider {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  name              String
  businessName      String   @map("business_name")
  phone_number      String   @db.VarChar(15)
  location          String?
  latitude          Decimal  @db.Decimal(9, 6)
  longitude         Decimal  @db.Decimal(9, 6)
  service_radius_km Decimal? @db.Decimal(5, 2)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  services     Service[]
  mediaUploads MediaUpload[]
  documents    Document[]

  @@map("providers")
}

// ─── PROVIDER ONBOARDING PROFILE ───────────────────────────────────────

model ProviderProfile {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @unique @map("user_id") @db.Uuid
  phone         String   @unique @db.VarChar(15)
  name          String?
  email         String?
  businessName  String?  @map("business_name")
  address       String?
  contactNumber String?  @map("contact_number") @db.VarChar(20)
  description   String?
  isVerified    Boolean  @default(false) @map("is_verified")
  otpVerified   Boolean  @default(false) @map("otp_verified")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  services          ProviderService[]
  verifications     ProviderVerification[]
  roomListings      RoomListing[]
  mealPlans         MealPlan[]

  @@map("provider_profiles")
}

model ProviderService {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerId String      @map("provider_id") @db.Uuid
  type       ServiceType

  provider        ProviderProfile  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  pgDetails       PGDetails?
  tiffinDetails   TiffinDetails?

  @@unique([providerId, type])
  @@map("provider_services")
}

model PGDetails {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceId String @unique @map("service_id") @db.Uuid
  pgName    String @map("pg_name")
  address   String

  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)

  roomType          String   @map("room_type")
  minPrice          Float    @map("min_price")
  securityDeposit   Float    @default(0) @map("security_deposit")
  reservationFee    Float    @default(0) @map("reservation_fee")
  minimumStayMonths Int      @default(1) @map("minimum_stay_months")
  numberOfBeds      Int      @default(1) @map("number_of_beds")
  amenities         String[]
  photos            String[]

  service ProviderService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  savedBy SavedListing[]

  @@map("pg_details")
}

model SavedListing {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  pgId      String   @map("pg_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  pg   PGDetails @relation(fields: [pgId], references: [id], onDelete: Cascade)

  @@unique([userId, pgId])
  @@index([userId, createdAt])
  @@map("saved_listings")
}

model TiffinDetails {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceId   String   @unique @map("service_id") @db.Uuid
  name        String
  price       Float
  mealsPerDay Int      @map("meals_per_day")
  latitude    Decimal? @db.Decimal(9, 6)
  longitude   Decimal? @db.Decimal(9, 6)
  photos      String[]

  service ProviderService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("tiffin_details")
}

model ProviderVerification {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerId String  @map("provider_id") @db.Uuid
  idType     String  @map("id_type")
  idNumber   String  @map("id_number")
  isVerified Boolean @default(false) @map("is_verified")

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, idType])
  @@map("provider_verifications")
}

// ─── SERVICES (junction: provider ↔ service types) ──────────────────────

model Service {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerId  String          @map("provider_id") @db.Uuid
  serviceType ServiceCategory @map("service_type")

  // Relations
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, serviceType])
  @@map("services")
}

// ─── PG ROOMS ───────────────────────────────────────────────────────────

model PGRoom {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider_id String   @db.Uuid
  pg_name     String
  address     String
  room_types  Json?
  min_price   Decimal? @db.Decimal(10, 2)
  max_price   Decimal? @db.Decimal(10, 2)
  amenities   Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("pg_rooms")
}

// ─── TIFFIN SERVICES ────────────────────────────────────────────────────

model TiffinService {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider_id       String    @db.Uuid
  kitchen_name      String
  foodType          FoodType? @map("food_type")
  meal_options      Json?
  monthly_price     Decimal?  @db.Decimal(10, 2)
  delivery_range_km Decimal?  @db.Decimal(5, 2)
  delivery_timing   String?
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("tiffin_services")
}

// ─── MEDIA UPLOADS ──────────────────────────────────────────────────────

model MediaUpload {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerId  String          @map("provider_id") @db.Uuid
  serviceType ServiceCategory @map("service_type")
  fileUrl     String          @map("file_url")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("media_uploads")
}

// ─── DOCUMENTS ──────────────────────────────────────────────────────────

model Document {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerId String   @map("provider_id") @db.Uuid
  docType    DocType  @map("doc_type")
  fileUrl    String   @map("file_url")
  verified   Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("documents")
}

// ─── BOOKING ENUMS ──────────────────────────────────────────────────────

enum BookingStatus {
  NEW         @map("new")
  ACCEPTED    @map("accepted")
  IN_PROGRESS @map("in_progress")
  COMPLETED   @map("completed")
  REJECTED    @map("rejected")

  @@map("booking_status")
}

enum VisitStatus {
  PENDING   @map("pending")
  APPROVED  @map("approved")
  COMPLETED @map("completed")

  @@map("visit_status")
}

enum PaymentType {
  RENT        @map("rent")
  RESERVATION @map("reservation")
  TIFFIN      @map("tiffin")

  @@map("payment_type")
}

enum PaymentStatus {
  PAID    @map("paid")
  PENDING @map("pending")
  FAILED  @map("failed")

  @@map("payment_status")
}

// Lifecycle status for room inventory
// ACTIVE  = visible to students, beds available
// FULL    = auto-set when available_beds hits 0
// CLOSED  = provider manually paused the listing
enum RoomStatus {
  ACTIVE @map("active")
  FULL   @map("full")
  CLOSED @map("closed")

  @@map("room_status")
}

enum ServiceListingStatus {
  ACTIVE @map("active")
  PAUSED @map("paused")
  DRAFT  @map("draft")
  HIDDEN @map("hidden")

  @@map("service_listing_status")
}

// ─── BOOKINGS ───────────────────────────────────────────────────────────

model Booking {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String        @map("user_id") @db.Uuid
  providerId         String        @map("provider_id") @db.Uuid
  roomId             String?       @map("room_id") @db.Uuid
  serviceType        String?       @map("service_type")
  roomType           String?       @map("room_type")
  reservationId      String?       @unique @map("reservation_id") @db.VarChar(64)
  status             BookingStatus @default(NEW)
  bookingDate        DateTime      @map("booking_date") @db.Date
  bookingTime        String        @map("booking_time")
  price              Decimal       @db.Decimal(10, 2)
  monthlyRent        Decimal       @default(0) @map("monthly_rent") @db.Decimal(10, 2)
  securityDeposit    Decimal       @default(0) @map("security_deposit") @db.Decimal(10, 2)
  reservationFee     Decimal       @default(0) @map("reservation_fee") @db.Decimal(10, 2)
  platformFee        Decimal       @default(0) @map("platform_fee") @db.Decimal(10, 2)
  minimumStayMonths  Int           @default(1) @map("minimum_stay_months")
  numberOfBeds       Int           @default(1) @map("number_of_beds")
  foodCharges        Decimal       @default(0) @map("food_charges") @db.Decimal(10, 2)
  electricityCharges Decimal       @default(0) @map("electricity_charges") @db.Decimal(10, 2)
  waterCharges       Decimal       @default(0) @map("water_charges") @db.Decimal(10, 2)
  maintenanceCharges Decimal       @default(0) @map("maintenance_charges") @db.Decimal(10, 2)
  parkingCharges     Decimal       @default(0) @map("parking_charges") @db.Decimal(10, 2)
  otherCharges       Decimal       @default(0) @map("other_charges") @db.Decimal(10, 2)
  moveInDate         DateTime?     @map("move_in_date") @db.Date
  studentName        String?       @map("student_name")
  studentPhone       String?       @map("student_phone") @db.VarChar(15)
  notes              String?
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  visitRequests VisitRequest[]
  payments      Payment[]
  receipt       Receipt?

  @@map("bookings")
}

// ─── VISIT REQUESTS ─────────────────────────────────────────────────────

model VisitRequest {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId    String      @map("booking_id") @db.Uuid
  userId       String      @map("user_id") @db.Uuid
  providerId   String      @map("provider_id") @db.Uuid
  visitDate    DateTime    @map("visit_date") @db.Date
  visitTime    String      @map("visit_time")
  status       VisitStatus @default(PENDING)
  instructions String?
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("visit_requests")
}

// ─── PROFILE VIEWS ──────────────────────────────────────────────────────

model ProfileView {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerId String   @map("provider_id") @db.Uuid
  viewerId   String?  @map("viewer_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("profile_views")
}

// ─── PAYMENTS ───────────────────────────────────────────────────────────

model Payment {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId     String?       @map("booking_id") @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  providerId    String        @map("provider_id") @db.Uuid
  amount        Decimal       @db.Decimal(10, 2)
  type          PaymentType
  status        PaymentStatus @default(PENDING)
  paymentMethod String?       @map("payment_method") @db.VarChar(60)
  transactionId String?       @unique @map("transaction_id") @db.VarChar(128)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@map("payments")
}

model Receipt {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId     String   @unique @map("booking_id") @db.Uuid
  receiptNumber String   @unique @map("receipt_number") @db.VarChar(80)
  payload       Json
  qrCode        String   @map("qr_code")
  generatedAt   DateTime @default(now()) @map("generated_at") @db.Timestamptz(6)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("receipts")
}

model Notification {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  title         String   @db.VarChar(200)
  message       String
  type          String   @default("service") @db.VarChar(40)
  eventType     String?  @map("event_type") @db.VarChar(80)
  channel       String   @default("IN_APP") @db.VarChar(30)
  status        String   @default("SENT") @db.VarChar(30)
  payload       Json?
  templateId    String?  @map("template_id") @db.Uuid
  reservationId String?  @map("reservation_id") @db.VarChar(64)
  isRead        Boolean  @default(false) @map("is_read")
  requestId     String?  @map("request_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  template NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

model NotificationTemplate {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key           String         @unique @db.VarChar(120)
  audience      String         @db.VarChar(30)
  channel       String         @default("IN_APP") @db.VarChar(30)
  titleTemplate String         @map("title_template") @db.VarChar(200)
  bodyTemplate  String         @map("body_template")
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  notifications Notification[]

  @@map("notification_templates")
}

model NotificationPreference {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  channel   String   @db.VarChar(30)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel])
  @@map("notification_preferences")
}

model NotificationLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notificationId String   @map("notification_id") @db.Uuid
  level          String   @db.VarChar(20)
  message        String
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([notificationId, createdAt])
  @@map("notification_logs")
}

model NotificationDevice {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  platform  String   @db.VarChar(30)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId, isActive])
  @@map("notification_devices")
}

model NotificationDelivery {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notificationId   String    @map("notification_id") @db.Uuid
  channel          String    @db.VarChar(30)
  status           String    @db.VarChar(30)
  providerResponse Json?     @map("provider_response")
  deliveredAt      DateTime? @map("delivered_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([notificationId, channel])
  @@map("notification_delivery")
}

model NotificationRetry {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notificationId String   @unique @map("notification_id") @db.Uuid
  attemptCount   Int      @default(0) @map("attempt_count")
  nextAttemptAt  DateTime @map("next_attempt_at") @db.Timestamptz(6)
  lastError      String?  @map("last_error")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([nextAttemptAt])
  @@map("notification_retry")
}

model NotificationDeadLetter {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notificationId String   @unique @map("notification_id") @db.Uuid
  reason         String
  payload        Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("notification_dead_letters")
}

model College {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String   @unique
  city       String
  university String?
  latitude   Decimal  @db.Decimal(9, 6)
  longitude  Decimal  @db.Decimal(9, 6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  users      User[]

  @@map("colleges")
}

// ─── ROOM INVENTORY (Provider Dashboard) ──────────────────────────────
// This is the production inventory table — separate from the onboarding
// pg_details table. Each row = one room TYPE a provider offers.
// availableBeds is decremented on booking confirmation.

model RoomListing {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerId String @map("provider_id") @db.Uuid

  // ── Core details ────────────────────────────────────────────
  title            String  @db.VarChar(200) // "Single AC Room"
  description      String? // long-form details
  address          String? @db.VarChar(500)
  roomType         String  @map("room_type") @db.VarChar(100) // "Single", "Double", "Triple"
  genderPreference String  @default("unisex") @map("gender_preference") @db.VarChar(20)

  // ── Pricing ──────────────────────────────────────────────
  price              Float // per month
  securityDeposit    Float @default(0) @map("security_deposit")
  reservationFee     Float @default(0) @map("reservation_fee")
  minimumStayMonths  Int   @default(1) @map("minimum_stay_months")
  numberOfBeds       Int   @default(1) @map("number_of_beds")
  platformFee        Float @default(0) @map("platform_fee")
  foodCharges        Float @default(0) @map("food_charges")
  electricityCharges Float @default(0) @map("electricity_charges")
  waterCharges       Float @default(0) @map("water_charges")
  maintenanceCharges Float @default(0) @map("maintenance_charges")
  parkingCharges     Float @default(0) @map("parking_charges")
  otherCharges       Float @default(0) @map("other_charges")

  // ── Inventory ─────────────────────────────────────────────
  totalBeds     Int @default(1) @map("total_beds")
  availableBeds Int @default(1) @map("available_beds")
  reservedBeds  Int @default(0) @map("reserved_beds")
  occupiedBeds  Int @default(0) @map("occupied_beds")
  blockedBeds   Int @default(0) @map("blocked_beds")
  offlineBeds   Int @default(0) @map("offline_beds")

  // ── Physical details ──────────────────────────────────────
  floor     Int? // null = ground floor or unknown
  amenities String[] @default([]) // ["WiFi", "AC", "Geyser"]
  images    String[] @default([]) // Supabase public URLs

  // ── Availability ──────────────────────────────────────────
  // isActive = provider-controlled (they can flip it anytime)
  // status   = derived lifecycle (ACTIVE / FULL / CLOSED)
  // Both must be true for students to see the listing.
  isActive Boolean    @default(true) @map("is_active")
  status   RoomStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("room_listings")
}

model MealPlan {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerId      String               @map("provider_id") @db.Uuid
  name            String               @db.VarChar(200)
  mealType        String?              @map("meal_type") @db.VarChar(80)
  foodType        String?              @map("food_type") @db.VarChar(30)
